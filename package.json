{
  "name": "oakwood-fence-permit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Survey-informed fence visualization and material estimator",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test 'tests/*.test.js'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "check:tracked": "node scripts/check-tracked.js",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run check:tracked"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
